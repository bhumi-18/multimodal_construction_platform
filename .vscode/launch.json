{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Run Platform (F5)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501",
                "--server.headless=false"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run Test Suite",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_platform.py",
            "console": "integratedTerminal"
        }
    ]
}
